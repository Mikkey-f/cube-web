# 统一换行符为 LF，避免 Windows / macOS 混用产生整文件 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.db    binary
*.jar   binary
*.ttf   binary
*.woff  binary
*.woff2 binary

# lock 文件在 diff 里折叠
frontend/package-lock.json -diff linguist-generated
